// One bar for the laptop panel and one for every other screen. They share
// bar.jsonc and differ only in which display custom/brightness controls:
// waybar does not pass the output name to on-scroll commands, so each bar
// names its target here. Styling lives in modules/custom/brightness.jsonc.
[
    {
        "include": ["~/.config/waybar/bar.jsonc"],
        "output": "eDP-1",
        "custom/brightness": {
            "exec": "~/.config/waybar/scripts/brightness.sh get internal",
            "interval": 1,  // catches the brightness keys, which call brightnessctl directly
            "on-scroll-up": "~/.config/waybar/scripts/brightness.sh up internal",
            "on-scroll-down": "~/.config/waybar/scripts/brightness.sh down internal"
        }
    },
    {
        "include": ["~/.config/waybar/bar.jsonc"],
        "output": "!eDP-1",
        "custom/brightness": {
            "exec": "~/.config/waybar/scripts/brightness.sh get ddc",
            "interval": 30,  // picks up changes made from the monitor's own menu
            "on-scroll-up": "~/.config/waybar/scripts/brightness.sh up ddc",
            "on-scroll-down": "~/.config/waybar/scripts/brightness.sh down ddc"
        }
    }
]
