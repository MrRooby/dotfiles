{
	// no "drawer" here on purpose: output *and* microphone stay
	// permanently visible instead of the mic hiding behind a hover
	"group/pulseaudio": {
		"orientation": "horizontal",
		"modules": [
			"pulseaudio#output",
			"pulseaudio#input"
		]
	},

	/*-------------------
	    output device
	-------------------*/

	"pulseaudio#output": {
		"format": "{icon} {volume}%",
		// "format-bluetooth":
		"format-muted": "{icon} {volume}%",
		// "format-source":
		// "format-source-muted":
		"format-icons": {
			"default": [ "󰕿", "󰖀", "󰕾" ],
			"default-muted": "󰝟",
			"headphone": "󰋋",
			"headphone-muted": "󰟎",
			"headset": "󰋎",
			"headset-muted": "󰋐"
		},
		// "rotate":
		// "states":
		"min-length": 7,
		"max-length": 7,
		// "align":
		// "justify":
		// "scroll-step":
		// pavucontrol is a GApplication: a second click raises the open
		// window instead of starting another. Tab 3 is "Output Devices".
		"on-click": "pavucontrol --tab=3",
		// "on-click-middle":
		"on-click-right": "~/.config/waybar/scripts/volume.sh output mute",
		// "on-update":
		"on-scroll-up": "~/.config/waybar/scripts/volume.sh output raise",
		"on-scroll-down": "~/.config/waybar/scripts/volume.sh output lower",
		// "smooth-scrolling-threshold":
		// "tooltip":
		"tooltip-format": "<b>Output Device</b>: {desc}"
		// "max-volume":
		// "ignored-sinks":
		// "reverse-scrolling":
		// "reverse-mouse-scrolling":
		// "menu":
		// "menu-file":
		// "menu-actions":
		// "expand":
	},

	/*----------------
	    microphone
	----------------*/

	"pulseaudio#input": {
		"format": "{format_source}",
		// "format-bluetooth":
		// "format-muted":
		"format-source": "󰍬 {volume}%",
		"format-source-muted": "󰍭 {volume}%",
		// "format-icons":
		// "rotate":
		// "states":
		"min-length": 7,
		"max-length": 7,
		// "align":
		// "justify":
		// "scroll-step":
		// tab 4 is "Input Devices"
		"on-click": "pavucontrol --tab=4",
		// "on-click-middle":
		"on-click-right": "~/.config/waybar/scripts/volume.sh input mute",
		// "on-update":
		"on-scroll-up": "~/.config/waybar/scripts/volume.sh input raise",
		"on-scroll-down": "~/.config/waybar/scripts/volume.sh input lower",
		// "smooth-scrolling-threshold":
		// "tooltip":
		"tooltip-format": "<b>Input Device</b>: {desc}"
		// "max-volume":
		// "ignored-sinks":
		// "reverse-scrolling":
		// "reverse-mouse-scrolling":
		// "menu":
		// "menu-file":
		// "menu-actions":
		// "expand":
	}
}
