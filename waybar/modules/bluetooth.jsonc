{
	"bluetooth": {
		// "controller":
		// "format-device-preference":
		"format": "󰂯",
		"format-disabled": "󰂲",
		"format-off": "󰂲",
		"format-on": "󰂰",
		"format-connected": "󰂱",
		// "format-connected-battery":
		// "format-no-controller":
		// "format-icons":
		// "rotate":
		"min-length": 2,
		"max-length": 2,
		// "align":
		// "justify":
    "on-click": "kitty --class bluetui-popup -o background_opacity=1.0 -e bluetui",
		// "on-click-middle":
		"on-click-right": "bluetoothctl power off && notify-send 'Bluetooth Off' -i 'network-bluetooth-inactive' -h string:x-canonical-private-synchronous:bluetooth",
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		// "tooltip":
		"tooltip-format": "Device Addr: {device_address}",
		"tooltip-format-disabled": "Bluetooth Disabled",
		"tooltip-format-off": "Bluetooth Off",
		"tooltip-format-on": "Bluetooth Disconnected",

		// {device_enumerate} is the only replacement that covers *every*
		// connected device -- {device_alias} on its own resolves to the single
		// preferred device, which is why this used to show one headset and no
		// second line. Each enumerated line is rendered with the two formats
		// below, waybar picking -battery for devices that expose
		// org.bluez.Battery1 and the plain one for those that do not.
		"tooltip-format-connected": "{device_enumerate}",
		"tooltip-format-connected-battery": "{device_enumerate}",
		"tooltip-format-enumerate-connected": "<b>{device_alias}</b>",
		"tooltip-format-enumerate-connected-battery": "<b>{device_alias}</b>: {device_battery_percentage}%"
		// "menu":
		// "menu-file":
		// "menu-actions":
		// "expand":
	}
}
