{
	/*----------------------------------------
	    cpu temperature, all-sensor tooltip
	----------------------------------------*/

	// replaces the built-in "temperature" module: that one reads a single
	// hwmon input and its tooltip-format only understands {temperatureC} /
	// {temperatureF}, so it can't list the GPU, SSD, EC and zone sensors
	"custom/temperature": {
		"exec": "~/.config/waybar/scripts/temperature.sh",
		"return-type": "json",
		"interval": 2,
		// The tooltip is a Quickshell popup (~/.config/quickshell/waybar-tooltips),
		// opened by on-enter/on-leave from waybar PR #5312 (see custom/cpu.jsonc).
		// The packaged waybar ignores both hooks, so there the module has no tooltip.
		"tooltip": false,
		"on-enter": "echo \"enter Temperature $WAYBAR_OUTPUT_NAME $WAYBAR_MODULE_X $WAYBAR_MODULE_WIDTH\" | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
		"on-enter-delay": 250,
		"on-leave": "echo leave | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
		"min-length": 8,
		"max-length": 8
	}
}
