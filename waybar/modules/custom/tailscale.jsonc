{
    "custom/tailscale": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/tailscale.sh",
        "on-click": "~/.config/waybar/scripts/tailscale.sh toggle",
        "on-click-right": "~/.config/waybar/scripts/tailscale.sh exit-node",
        "interval": 5,
        "signal": 12,
        // The tooltip is a Quickshell popup (~/.config/quickshell/waybar-tooltips,
        // modules/Tailscale.qml: peers with click-to-copy IPs and MagicDNS names),
        // opened by on-enter/on-leave from waybar PR #5312; see custom/cpu.jsonc.
        "tooltip": false,
        "on-enter": "echo \"enter Tailscale $WAYBAR_OUTPUT_NAME $WAYBAR_MODULE_X $WAYBAR_MODULE_WIDTH\" | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
        "on-enter-delay": 250,
        "on-leave": "echo leave | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock"
    }
}
