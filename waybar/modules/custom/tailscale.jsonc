{
    "custom/tailscale": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/tailscale.sh",
        "on-click": "~/.config/waybar/scripts/tailscale.sh toggle",
        "on-click-right": "~/.config/waybar/scripts/tailscale.sh exit-node",
        "interval": 5,
        "signal": 12,
        "tooltip": true
    }
}
