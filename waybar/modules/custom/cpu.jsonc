{
	/*----------------------------------------
	    cpu usage, per-thread tooltip
	----------------------------------------*/

	// replaces the built-in "cpu" module: that one accepts only
	// tooltip on/off, and never reports per-thread clocks
	"custom/cpu": {
		"exec": "~/.config/waybar/scripts/cpu.sh",
		"return-type": "json",
		"interval": 1,
		// The tooltip is a Quickshell popup (~/.config/quickshell/waybar-tooltips),
		// opened by on-enter/on-leave. Those hooks come from waybar PR #5312, and
		// WAYBAR_OUTPUT_NAME in them from a local patch on top: waybar-run.sh
		// starts ~/.local/lib/waybar-pr5312/waybar, built from ~/src/waybar-pr5312.
		// The packaged waybar ignores both hooks, so there the module has no tooltip.
		"tooltip": false,
		"on-enter": "echo \"enter Cpu $WAYBAR_OUTPUT_NAME $WAYBAR_MODULE_X $WAYBAR_MODULE_WIDTH\" | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
		"on-enter-delay": 250,
		"on-leave": "echo leave | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
		"min-length": 6,
		"max-length": 6
	}
}
