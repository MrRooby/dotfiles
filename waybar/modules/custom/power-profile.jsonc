{
	/*--------------------------------------------
	    battery level + power profile switcher
	--------------------------------------------*/

	// The profile buttons live in the battery's Quickshell popup
	// (modules/Battery.qml), so the bar no longer slides them out: the group
	// holds just the battery. The custom/pp_* modules below are unused.
	// turbo is performance with raised CPU power limits (ryzen-limits.service).
	"group/battery_profile": {
		"orientation": "horizontal",
		"modules": [
			"custom/battery"
		],
		// the battery's popup (see custom/battery.jsonc)
		"on-enter": "echo \"enter Battery $WAYBAR_OUTPUT_NAME $WAYBAR_MODULE_X $WAYBAR_MODULE_WIDTH\" | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
		"on-enter-delay": 250,
		"on-leave": "echo leave | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock"
	},

	"custom/pp_turbo": {
		"exec": "~/.config/waybar/scripts/power-profile.sh get turbo",
		"return-type": "json",
		"tooltip": false,  // the battery popup has the profile buttons with their names
		"interval": 10,
		"signal": 7,
		"on-click": "~/.config/waybar/scripts/power-profile.sh set turbo",
		"min-length": 3,
		"max-length": 3
	},

	"custom/pp_performance": {
		"exec": "~/.config/waybar/scripts/power-profile.sh get performance",
		"return-type": "json",
		"tooltip": false,  // the battery popup has the profile buttons with their names
		"interval": 10,
		"signal": 7,
		"on-click": "~/.config/waybar/scripts/power-profile.sh set performance",
		"min-length": 3,
		"max-length": 3
	},

	"custom/pp_balanced": {
		"exec": "~/.config/waybar/scripts/power-profile.sh get balanced",
		"return-type": "json",
		"tooltip": false,  // the battery popup has the profile buttons with their names
		"interval": 10,
		"signal": 7,
		"on-click": "~/.config/waybar/scripts/power-profile.sh set balanced",
		"min-length": 3,
		"max-length": 3
	},

	"custom/pp_saver": {
		"exec": "~/.config/waybar/scripts/power-profile.sh get power-saver",
		"return-type": "json",
		"tooltip": false,  // the battery popup has the profile buttons with their names
		"interval": 10,
		"signal": 7,
		"on-click": "~/.config/waybar/scripts/power-profile.sh set power-saver",
		"min-length": 3,
		"max-length": 3
	}
}
