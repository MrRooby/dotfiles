{
	/*---------------------------------------------
	    link icon, connection detail in tooltip
	---------------------------------------------*/

	// replaces the built-in "network" module (modules/network.jsonc), whose
	// tooltip covers one interface and has no link rate, security or DNS.
	// interval 5 so the down/up rate in the tooltip reads as live.
	"custom/network": {
		"exec": "~/.config/waybar/scripts/network-status.sh",
		"return-type": "json",
		"format": "{}",
		"interval": 5,
		"min-length": 2,
		"max-length": 2,
		// The tooltip is a Quickshell popup (~/.config/quickshell/waybar-tooltips),
		// opened by on-enter/on-leave (waybar PR #5312 build, see custom/cpu.jsonc).
		// The packaged waybar ignores both hooks, so there the module has no tooltip.
		"tooltip": false,
		"on-enter": "echo \"enter Network $WAYBAR_OUTPUT_NAME $WAYBAR_MODULE_X $WAYBAR_MODULE_WIDTH\" | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
		"on-enter-delay": 250,
		"on-leave": "echo leave | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
		"on-click": "~/.config/waybar/scripts/popup.sh impala-popup wlctl"
	}
}
