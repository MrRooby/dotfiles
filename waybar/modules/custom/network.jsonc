{
	/*---------------------------------------------
	    link icon, connection detail in tooltip
	---------------------------------------------*/

	// replaces the built-in "network" module (modules/network.jsonc), whose
	// tooltip covers one interface and has no link rate, security or DNS.
	// interval 5 so the down/up rate in the tooltip reads as live.
	"custom/network": {
		"exec": "~/.config/waybar/scripts/network-status.sh",
		"return-type": "json",
		"format": "{}",
		"interval": 5,
		"min-length": 2,
		"max-length": 2,
		"on-click": "~/.config/waybar/scripts/popup.sh impala-popup wlctl"
	}
}
