{
	// Brightness of the screen this bar sits on. The exec / on-scroll commands
	// are set per bar in config.jsonc ("internal" for the laptop panel, "ddc"
	// for an external monitor), because waybar does not tell on-scroll commands
	// which output they fired on. The script sends signal 13 after every scroll.
	"custom/brightness": {
		"format": "{icon} {text}",
		"format-icons": [
			"", "", "", "", "", "", "", "", ""
		],
		"return-type": "json",
		"signal": 13,
		"min-length": 7,
		"max-length": 7,
		// The tooltip is a Quickshell popup (~/.config/quickshell/waybar-tooltips,
		// modules/Brightness.qml) with a slider, opened by on-enter/on-leave from
		// the waybar PR #5312 build (see custom/cpu.jsonc). It picks the screen
		// from the bar it opens under, so it needs no per-bar override.
		"tooltip": false,
		"on-enter": "echo \"enter Brightness $WAYBAR_OUTPUT_NAME $WAYBAR_MODULE_X $WAYBAR_MODULE_WIDTH\" | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
		"on-enter-delay": 250,
		"on-leave": "echo leave | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
		"on-click": "nwg-displays"  // window placed top-right by the sway for_window rule
	}
}
