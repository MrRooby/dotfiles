{
	/*--------------------------------
	    date, with a month calendar
	--------------------------------*/

	// replaces the built-in "clock#date": waybar draws {calendar} itself and
	// the only styling it takes is pango inside the calendar.format strings,
	// which have to carry a literal hex colour -- and the theme switcher works
	// by copying a file over current-theme.css, so a hardcoded accent there
	// stops tracking the theme. see scripts/calendar.sh.
	//
	// the built-in's click cycled a year view; scrolling through months and
	// clicking back to today is the trade.
	//
	// signal 10 is the next one free (1 = system_update, 7 = power-profile,
	// 8 = caffeine, 9 = bluetooth); the nav subcommands raise it so the grid
	// moves under the cursor rather than at the next poll.
	"custom/date": {
		"exec": "~/.config/waybar/scripts/calendar.sh",
		"return-type": "json",
		"interval": 60,
		"signal": 10,
		"on-click": "~/.config/waybar/scripts/calendar.sh today",
		"on-scroll-up": "~/.config/waybar/scripts/calendar.sh prev",
		"on-scroll-down": "~/.config/waybar/scripts/calendar.sh next",
		// The tooltip is a Quickshell popup (~/.config/quickshell/waybar-tooltips,
		// modules/Calendar.qml), opened by on-enter/on-leave from waybar PR #5312
		// (see custom/cpu.jsonc). It shares the month offset with the bar through
		// the state file and runs this script's prev/next/today for its buttons.
		"tooltip": false,
		"on-enter": "echo \"enter Calendar $WAYBAR_OUTPUT_NAME $WAYBAR_MODULE_X $WAYBAR_MODULE_WIDTH\" | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
		"on-enter-delay": 250,
		"on-leave": "echo leave | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
		"min-length": 8,
		"max-length": 8
	}
}
