{
    "custom/hotspot": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/hotspot.sh",
        "on-click": "~/.config/waybar/scripts/hotspot.sh toggle",
        "interval": 5,
        "signal": 11,
        // The tooltip is a Quickshell popup (~/.config/quickshell/waybar-tooltips,
        // modules/Hotspot.qml), opened by on-enter/on-leave (waybar PR #5312,
        // see custom/cpu.jsonc). The packaged waybar ignores both hooks.
        "tooltip": false,
        "on-enter": "echo \"enter Hotspot $WAYBAR_OUTPUT_NAME $WAYBAR_MODULE_X $WAYBAR_MODULE_WIDTH\" | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
        "on-enter-delay": 250,
        "on-leave": "echo leave | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock"
    }
}
