{
	/*------------------------------------------------------
	    typing speed, live / average / peak in the tooltip
	------------------------------------------------------*/

	"custom/wpm": {
		"exec": "~/.config/waybar/scripts/wpm.sh",
		"return-type": "json",
		"format": "󰓅 {}WPM",
		// the tooltip is a Quickshell popup (~/.config/quickshell/waybar-tooltips,
		// modules/Wpm.qml), opened by on-enter/on-leave from waybar PR #5312;
		// see custom/cpu.jsonc. It reads the daemon's socket itself.
		"tooltip": false,
		"on-enter": "echo \"enter Wpm $WAYBAR_OUTPUT_NAME $WAYBAR_MODULE_X $WAYBAR_MODULE_WIDTH\" | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
		"on-enter-delay": 250,
		"on-leave": "echo leave | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
		// no interval: the script keeps running and prints a line whenever
		// the score changes. it ends when the daemon goes away, and this
		// starts it again
		"restart-interval": 5
	}
}
