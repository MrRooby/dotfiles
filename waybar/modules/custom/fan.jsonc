{
	"custom/fan": {
		"interval": 5,
		"format": " {}RPM",
		// "format-icons":
		"min-length": 9,
		// "max-length": 9 would clip a 4-digit reading exactly at the edge
		// "max-length":
		"exec": "~/.config/waybar/scripts/fan.sh",
		"return-type": "json",
		// "align":
		// "justify":
		// "rotate":
		// "on-click":
		// "on-click-middle":
		// "on-click-right":
		// "on-update":
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		// The tooltip is a Quickshell popup (~/.config/quickshell/waybar-tooltips,
		// modules/Fan.qml): level, controlling temperature and thinkfan's curve.
		// It is opened by on-enter/on-leave, hooks from waybar PR #5312 (see
		// modules/custom/cpu.jsonc); the packaged waybar ignores them.
		"tooltip": false,
		"on-enter": "echo \"enter Fan $WAYBAR_OUTPUT_NAME $WAYBAR_MODULE_X $WAYBAR_MODULE_WIDTH\" | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock",
		"on-enter-delay": 250,
		"on-leave": "echo leave | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/waybar-tooltips.sock"
		// "expand":
	}
}
