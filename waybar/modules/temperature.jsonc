{
	"temperature": {
		// "thermal-zone": 1,
		// "hwmon-path":
		// the hwmon index is not stable across boots, so resolve it at runtime
		"hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
		"input-filename": "temp1_input",
		// "warning-threshold":
		"critical-threshold": 90,
		"interval": 1,
		// "format-warning":
		"format-critical": "󰀦 {temperatureC}°C",
		"format": "{icon} {temperatureC}°C",
		"format-icons": [
			"󱃃", "󰔏", "󱃂"
		],
		// "rotate":
		"min-length": 8,
		"max-length": 8,
